# WorkSpaceX desktop runtime — значения по docs/architecture/windows-installation.md
# Порты: HTTPS-шлюз, Next standalone, Ollama — все разные, все на loopback (кроме слушающего хоста).
WSX_HTTPS_PORT=38631
WSX_NEXT_PORT=38632
WSX_LOOPBACK=127.0.0.1
WSX_LISTEN_HOST=0.0.0.0
OLLAMA_HOST=127.0.0.1:38633
OLLAMA_URL=http://127.0.0.1:38633
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
CLOUD_STORAGE=local
# Лимиты запросов и срок сессии (дефолты из lib/env.ts)
APP_SESSION_TTL_HOURS=12
AI_RATE_PER_MIN=10
AI_RATE_PER_DAY=200
MCP_RATE_PER_MIN=60
# Подпись модели в интерфейсе (см. lib/data.ts)
NEXT_PUBLIC_AI_MODEL_LABEL=Qwen2.5-VL 3B
LOG_LEVEL=info
