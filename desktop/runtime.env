# WorkSpaceX desktop runtime — значения по docs/architecture/windows-installation.md
# Порты: HTTPS-шлюз и Next standalone — разные, оба на loopback (кроме слушающего хоста).
# Локального ИИ-движка в продукте нет: модель подключается в настройках
# (OpenRouter или свой OpenAI-совместимый сервер), ключ хранится шифротекстом.
WSX_HTTPS_PORT=38631
WSX_NEXT_PORT=38632
WSX_LOOPBACK=127.0.0.1
WSX_LISTEN_HOST=0.0.0.0
CLOUD_STORAGE=local
# Лимиты запросов и срок сессии (дефолты из lib/env.ts)
APP_SESSION_TTL_HOURS=12
AI_RATE_PER_MIN=10
AI_RATE_PER_DAY=200
MCP_RATE_PER_MIN=60
LOG_LEVEL=info
