    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
